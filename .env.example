# Supabase (Vite exposes VITE_* to the client)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Notification mode (client is the source of truth):
#   mock   → browser simulates WhatsApp (toast), no server call
#   twilio → browser calls Edge Functions; server sends via Twilio
VITE_SERVICE_TYPE="mock"

# Optional: pin PWA cache version (Docker sets this automatically)
# VITE_BUILD_ID="1.0.0"

# APP_URL: Production URL (used by send-email-notification Edge Function).
APP_URL="https://your-app.vercel.app"

# Edge Function secrets (Supabase Dashboard → Edge Functions → Secrets — NOT in this file):
# TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_FROM_NUMBER (optional)
# GROQ_API_KEY, SERPER_API_KEY, LANGFUSE_PUBLIC_KEY, LANGFUSE_SECRET_KEY
# RESEND_API_KEY
#
# Sentry (optional — client error monitoring, NOT a Supabase secret):
# VITE_SENTRY_DSN=https://your-key@o....ingest.us.sentry.io/...
# See docs/DEPLOYMENT_GUIDE.md#sentry
